{
  "name": "whale",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@11.28.9+sha512.35421cea2720eca3f5ad722b67e8ef18f4d3cd4745ed2fcfeb0dc288d4e9437fad3870d91ee6e83f268f0f6f7e0f62723317b19617bb45ee4333172ef51159f8",
  "engines": {
    "node": ">=22.12.0"
  },
  "exports": {
    ".": "./dist/src/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "tsc -p tsconfig.json && node --test dist/test/*.test.js",
    "start:executor": "node dist/src/executor-server.js",
    "start:cli": "node dist/src/cli.js",
    "create-wallet": "node dist/src/create-wallet.js",
    "policy:turnkey": "tsc -p tsconfig.json && node scripts/write-turnkey-policy.mjs",
    "check:size": "node scripts/check-file-size.mjs",
    "check:boundaries": "node scripts/check-boundaries.mjs",
    "check": "node scripts/check-file-size.mjs && node scripts/check-boundaries.mjs && tsc -p tsconfig.json && node --test dist/test/*.test.js",
    "start:mcp": "node dist/src/mcp-server.js",
    "smoke": "tsc -p tsconfig.json && node scripts/smoke-entrypoints.mjs",
    "canary": "tsc -p tsconfig.json && node dist/src/canary.js",
    "policy:manifest": "tsc -p tsconfig.json && node scripts/turnkey-policy.mjs"
  },
  "dependencies": {
    "@fastify/auth": "5.1.2",
    "@fastify/rate-limit": "11.2.1",
    "@msgpack/msgpack": "3.1.3",
    "@solana/web3.js": "1.99.0",
    "@turnkey/sdk-server": "4.12.2",
    "bs58": "6.0.0",
    "fastify": "5.12.7",
    "pg": "8.23.1",
    "pino": "10.4.0",
    "viem": "2.57.13",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/pg": "8.23.1",
    "typescript": "5.9.3"
  }
}
