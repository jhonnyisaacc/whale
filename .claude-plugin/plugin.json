{
  "name": "whale",
  "description": "Whale, a multichain wallet for AI agents. Quote, swap, bridge, balance, and transfer. Dry-run is the default.",
  "version": "0.1.0",
  "author": {
    "name": "Rocket"
  },
  "repository": "https://github.com/jhonnyisaacc/whale",
  "license": "MIT",
  "keywords": [
    "rocket",
    "agentic wallet",
    "multichain wallet",
    "turnkey"
  ],
  "mcpServers": {
    "whale": {
      "type": "stdio",
      "command": "node",
      "args": [
        "${CLAUDE_PLUGIN_ROOT}/scripts/mcp-server.mjs"
      ],
      "env": {
        "EXECUTOR_URL": "http://127.0.0.1:8788",
        "EXECUTOR_AUTH_TOKEN": "<executor token>"
      }
    }
  }
}
