------------------------------ MODULE SpendCap ------------------------------
(***************************************************************************)
(* The executor's daily USD cap on live sends.                             *)
(*                                                                         *)
(* src/executor.ts commitLive reserves the notional in spend_journal       *)
(* (src/spend.ts), the EVM send path in src/broadcast/evm.ts signs,        *)
(* journals and broadcasts, and commitLive commits or releases the         *)
(* reservation. reconcileReserved (src/spend.ts), which                    *)
(* src/executor-server.ts runs on a timer, settles what a send left        *)
(* reserved. The executor can restart at any point, which empties its      *)
(* reportsOf map, and a strategy can call again with the same key.         *)
(*                                                                         *)
(* One hot wallet on one EVM chain, one spend day, single-leg routes.      *)
(* SpendCode is generated by check.mjs from reserveDecision and            *)
(* reconcileDecision in the built src/spend.ts.                            *)
(***************************************************************************)
EXTENDS Naturals, Sequences, FiniteSets, TLC, SpendCode

CONSTANTS
    Keys,        \* idempotency keys
    Usd,         \* notional of every send, whole USD
    Cap,         \* DAILY_USD_CAP
    MaxNonce,    \* highest hot-wallet nonce in the model
    MaxTxs,      \* signed transactions, replacements included
    MaxCalls,    \* /execute calls
    MaxRestarts, \* executor restarts
    Passes       \* reconcileReserved passes that can run at the same time

ASSUME Usd \in UsdRange /\ Cap \in CapRange /\ Cardinality(Keys) * Usd \in SpentRange
ASSUME MaxTxs <= MaxAgedTxs
ASSUME {MaxNonce, MaxTxs, MaxCalls, MaxRestarts} \subseteq Nat /\ Passes \in Nat \ {0}

VARIABLES
    status,      \* spend_journal.status by key, "none" while the key has no row
    tx,          \* signed transactions in signing order: key, nonce, what the chain did with it
    journaled,   \* ids with a signed_tx row (recordTx)
    chainNonce,  \* the hot wallet's next nonce, confirmed REORG_DEPTH blocks below the head
    pool,        \* ids that some mempool holds
    call,        \* /execute calls in arrival order: pc, key, the ids it signed
    reports,     \* keys with an entry in the running executor's reportsOf map
    restarts,
    pass         \* reconcile passes: rows selected, row in hand, signed ids read for it

vars == <<status, tx, journaled, chainNonce, pool, call, reports, restarts, pass>>

Held == {"reserved", "committed"}
\* From the reservation to the return. The boot check in src/managed-signer.ts assertBoot keeps
\* RECONCILE_AFTER_MINUTES above this span (drainTimeoutMs in src/config/public.ts).
Sending == {"reserved", "journaled", "confirming", "replaced"}
IdlePass == [pc |-> "idle", rows |-> {}, row |-> {}, seen |-> {}]

TypeOK ==
    /\ status \in [Keys -> {"none", "reserved", "committed", "released"}]
    /\ tx \in Seq([key: Keys, nonce: 0..MaxNonce, mined: {"no", "landed", "reverted"}])
    /\ Len(tx) <= MaxTxs
    /\ journaled \subseteq DOMAIN tx
    /\ chainNonce \in 0..(MaxNonce + 1)
    /\ pool \subseteq DOMAIN tx
    /\ call \in Seq([pc: {"quoting", "done", "lost"} \cup Sending, key: Keys, txs: SUBSET DOMAIN tx])
    /\ reports \subseteq Keys
    /\ restarts \in 0..MaxRestarts
    /\ pass \in [1..Passes -> [pc: {"idle", "selected", "read"}, rows: SUBSET Keys, row: SUBSET Keys, seen: SUBSET DOMAIN tx]]

Init ==
    /\ status = [k \in Keys |-> "none"]
    /\ tx = <<>>
    /\ journaled = {}
    /\ chainNonce = 0
    /\ pool = {}
    /\ call = <<>>
    /\ reports = {}
    /\ restarts = 0
    /\ pass = [p \in 1..Passes |-> IdlePass]

Spent == Usd * Cardinality({k \in Keys : status[k] \in Held})

\* COMMIT_SQL and RELEASE_SQL touch only a row whose status is 'reserved'.
Commit(k) == status' = IF status[k] = "reserved" THEN [status EXCEPT ![k] = "committed"] ELSE status
Release(k) == status' = IF status[k] = "reserved" THEN [status EXCEPT ![k] = "released"] ELSE status

SetPc(c, pc) == call' = [call EXCEPT ![c].pc = pc]
At(c, pcs) == c \in DOMAIN call /\ call[c].pc \in pcs

(* ---------------------------- executor ---------------------------------- *)

\* execute(): a key with an entry in reportsOf gets that report back and does nothing else.
Call(k) ==
    /\ Len(call) < MaxCalls
    /\ k \notin reports
    /\ call' = Append(call, [pc |-> "quoting", key |-> k, txs |-> {}])
    /\ UNCHANGED <<status, tx, journaled, chainNonce, pool, reports, restarts, pass>>

\* commitLive: reportsOf.set, then recordSpend: reserveDecision under pg_advisory_xact_lock, then
\* RESERVE_UPSERT_SQL, which inserts the row or re-reserves a released one. "cap" deletes the report.
Reserve(c) ==
    LET k == call[c].key
        d == ReserveDecision(status[k], Spent, Usd, Cap)
    IN /\ At(c, {"quoting"})
       /\ CASE d = "reserved" -> /\ status' = [status EXCEPT ![k] = "reserved"]
                                 /\ reports' = reports \cup {k}
                                 /\ SetPc(c, "reserved")
            [] d = "exists"   -> /\ reports' = reports \cup {k}
                                 /\ SetPc(c, "done")
                                 /\ UNCHANGED status
            [] d = "cap"      -> /\ reports' = reports \ {k}
                                 /\ SetPc(c, "done")
                                 /\ UNCHANGED status
       /\ UNCHANGED <<tx, journaled, chainNonce, pool, restarts, pass>>

\* submitEvm: nonces.use hands out the cached or pending nonce, signEvm signs, and journal() runs
\* onTx -> recordTx, which writes signed_tx before broadcastEvm runs.
Journal(c) ==
    LET t == Len(tx) + 1
    IN /\ At(c, {"reserved"})
       /\ Len(tx) < MaxTxs
       /\ \E n \in {chainNonce, chainNonce + 1} \cap 0..MaxNonce :
             tx' = Append(tx, [key |-> call[c].key, nonce |-> n, mined |-> "no"])
       /\ journaled' = journaled \cup {t}
       /\ call' = [call EXCEPT ![c].pc = "journaled", ![c].txs = {t}]
       /\ UNCHANGED <<status, chainNonce, pool, reports, restarts, pass>>

\* BroadcastError(broadcast = false): a firm quote, simulation, signer or journal failure before the
\* broadcast, or a rejection every sender gave before its mempool. commitLive releases.
FailBeforeBroadcast(c) ==
    LET k == call[c].key
    IN /\ At(c, {"reserved", "journaled"})
       /\ Release(k)
       /\ reports' = reports \ {k}
       /\ SetPc(c, "done")
       /\ UNCHANGED <<tx, journaled, chainNonce, pool, restarts, pass>>

\* broadcastEvm: a sender accepted it, or the answer was ambiguous (a timeout or 5xx), which throws
\* BroadcastError(broadcast = true); commitLive then keeps the reservation for reconcile.
Broadcast(c) ==
    /\ At(c, {"journaled"})
    /\ \/ /\ pool' = pool \cup call[c].txs
          /\ SetPc(c, "confirming")
       \/ /\ pool' \in {pool, pool \cup call[c].txs}
          /\ SetPc(c, "done")
    /\ UNCHANGED <<status, tx, journaled, chainNonce, reports, restarts, pass>>

\* confirmEvm finds a receipt; runLegs and commitLive commit a landed send and release a reverted one.
Receipt(c) ==
    LET k == call[c].key
    IN /\ At(c, {"confirming", "replaced"})
       /\ \E t \in call[c].txs :
             /\ tx[t].mined # "no"
             /\ IF tx[t].mined = "landed"
                   THEN Commit(k) /\ UNCHANGED reports
                   ELSE Release(k) /\ reports' = reports \ {k}
       /\ SetPc(c, "done")
       /\ UNCHANGED <<tx, journaled, chainNonce, pool, restarts, pass>>

\* The first receipt poll times out (also when a receipt read fails). replaceEvm signs the same nonce
\* with bumped fees, journals it, and broadcasts it, or gives up on the replacement.
Replace(c) ==
    LET t == Len(tx) + 1
        first == CHOOSE u \in call[c].txs : TRUE
    IN /\ At(c, {"confirming"})
       /\ \/ /\ SetPc(c, "replaced")
             /\ UNCHANGED <<tx, journaled, pool>>
          \/ /\ Len(tx) < MaxTxs
             /\ tx' = Append(tx, [key |-> call[c].key, nonce |-> tx[first].nonce, mined |-> "no"])
             /\ journaled' = journaled \cup {t}
             /\ pool' \in {pool, pool \cup {t}}
             /\ call' = [call EXCEPT ![c].pc = "replaced", ![c].txs = @ \cup {t}]
       /\ UNCHANGED <<status, chainNonce, reports, restarts, pass>>

\* The second poll times out: the records stay pending, and commitLive keeps the reservation.
GiveUp(c) ==
    /\ At(c, {"replaced"})
    /\ SetPc(c, "done")
    /\ UNCHANGED <<status, tx, journaled, chainNonce, pool, reports, restarts, pass>>

\* The process exits (deploy, crash, executorLockLost). Calls in flight stop, reportsOf and the
\* running reconcile passes are gone. Postgres and the chain keep what they have.
Restart ==
    /\ restarts < MaxRestarts
    /\ restarts' = restarts + 1
    /\ call' = [c \in DOMAIN call |-> IF call[c].pc \in Sending \cup {"quoting"} THEN [call[c] EXCEPT !.pc = "lost"] ELSE call[c]]
    /\ reports' = {}
    /\ pass' = [p \in 1..Passes |-> IdlePass]
    /\ UNCHANGED <<status, tx, journaled, chainNonce, pool>>

(* ------------------------------ chain ----------------------------------- *)

\* A block includes a pooled transaction at the next nonce. Every other transaction at that nonce
\* can never be included.
Mine(t) ==
    /\ t \in pool
    /\ tx[t].nonce = chainNonce
    /\ \E r \in {"landed", "reverted"} : tx' = [tx EXCEPT ![t].mined = r]
    /\ chainNonce' = chainNonce + 1
    /\ pool' = {u \in pool : tx[u].nonce > chainNonce}
    /\ UNCHANGED <<status, journaled, call, reports, restarts, pass>>

\* Another transaction from the hot wallet, outside these keys, takes the next nonce.
OtherTx ==
    /\ chainNonce <= MaxNonce
    /\ chainNonce' = chainNonce + 1
    /\ pool' = {u \in pool : tx[u].nonce > chainNonce}
    /\ UNCHANGED <<status, tx, journaled, call, reports, restarts, pass>>

(* ---------------------------- reconcile --------------------------------- *)

\* RESERVED_SQL picks reserved rows older than RECONCILE_AFTER_MINUTES. Because that exceeds the send
\* bound, the call that made the reservation has returned or died.
Eligible == {k \in Keys : status[k] = "reserved" /\ \A c \in DOMAIN call : call[c].key = k => call[c].pc \notin Sending}

Select(p) ==
    /\ pass[p].pc = "idle"
    /\ \E rows \in (SUBSET Eligible) \ {{}} :
          pass' = [pass EXCEPT ![p] = [IdlePass EXCEPT !.pc = "selected", !.rows = rows]]
    /\ UNCHANGED <<status, tx, journaled, chainNonce, pool, call, reports, restarts>>

\* SIGNED_FOR_KEY_SQL, one selected row at a time.
ReadSigned(p) ==
    /\ pass[p].pc = "selected"
    /\ \E k \in pass[p].rows :
          pass' = [pass EXCEPT ![p] = [pc |-> "read", rows |-> @.rows \ {k}, row |-> {k}, seen |-> {t \in journaled : tx[t].key = k}]]
    /\ UNCHANGED <<status, tx, journaled, chainNonce, pool, call, reports, restarts>>

EndPass(p) ==
    /\ pass[p].pc = "selected"
    /\ pass[p].rows = {}
    /\ pass' = [pass EXCEPT ![p] = IdlePass]
    /\ UNCHANGED <<status, tx, journaled, chainNonce, pool, call, reports, restarts>>

\* lookupAgedTx in src/broadcast.ts: a receipt decides; with none, a confirmed nonce past the
\* transaction's makes it expired; otherwise it is pending.
Outcome(t) ==
    IF tx[t].mined # "no" THEN tx[t].mined
    ELSE IF tx[t].nonce < chainNonce THEN "expired" ELSE "pending"

\* Each lookup can fail, which reconcileReserved turns into null ("unknown"). reconcileDecision
\* decides, and COMMIT_SQL or RELEASE_SQL applies it.
Settle(p) ==
    LET k == CHOOSE key \in pass[p].row : TRUE
        seen == pass[p].seen
    IN /\ pass[p].pc = "read"
       /\ \E failed \in SUBSET seen :
             LET out(t) == IF t \in failed THEN "unknown" ELSE Outcome(t)
                 n(o) == Cardinality({t \in seen : out(t) = o})
                 d == ReconcileDecision(n("landed"), n("reverted"), n("expired"), n("pending"), n("unknown"))
             IN CASE d = "commit"  -> Commit(k)
                  [] d = "release" -> Release(k)
                  [] d = "keep"    -> UNCHANGED status
       /\ pass' = [pass EXCEPT ![p] = [@ EXCEPT !.pc = "selected", !.row = {}, !.seen = {}]]
       /\ UNCHANGED <<tx, journaled, chainNonce, pool, call, reports, restarts>>

Next ==
    \/ \E k \in Keys : Call(k)
    \/ \E c \in 1..MaxCalls : Reserve(c)
    \/ \E c \in 1..MaxCalls : Journal(c)
    \/ \E c \in 1..MaxCalls : FailBeforeBroadcast(c)
    \/ \E c \in 1..MaxCalls : Broadcast(c)
    \/ \E c \in 1..MaxCalls : Receipt(c)
    \/ \E c \in 1..MaxCalls : Replace(c)
    \/ \E c \in 1..MaxCalls : GiveUp(c)
    \/ Restart
    \/ \E t \in 1..MaxTxs : Mine(t)
    \/ OtherTx
    \/ \E p \in 1..Passes : Select(p)
    \/ \E p \in 1..Passes : ReadSigned(p)
    \/ \E p \in 1..Passes : EndPass(p)
    \/ \E p \in 1..Passes : Settle(p)

Spec == Init /\ [][Next]_vars

\* Every key sends the same Usd, so swapping keys changes nothing the invariants read.
KeySymmetry == Permutations(Keys)

(* ---------------------------- invariants -------------------------------- *)

Landed(k) == \E t \in DOMAIN tx : tx[t].key = k /\ tx[t].mined = "landed"

\* A send that moved money keeps counting against today's cap.
LandedStaysCounted == \A k \in Keys : Landed(k) => status[k] \in Held

\* The wallet never moves more than DAILY_USD_CAP in a day.
WithinCap == Usd * Cardinality({t \in DOMAIN tx : tx[t].mined = "landed"}) <= Cap

\* One idempotency key moves money at most once.
OneLandingPerKey == \A k \in Keys : Cardinality({t \in DOMAIN tx : tx[t].key = k /\ tx[t].mined = "landed"}) <= 1

=============================================================================
